# NutriMate Server Environment Variables
PORT=3000
NODE_ENV=development

# ========================================================
# OPTION 1: PostgreSQL Cloud (Khuyên dùng cho nhóm - Neon.tech)
# ========================================================
PGHOST=ep-example-pooler.ap-southeast-1.aws.neon.tech
PGPORT=5432
PGUSER=neondb_owner
PGPASSWORD=your_neon_password
PGDATABASE=neondb
PGSSLMODE=require
PGCHANNELBINDING=require

# Hoặc dùng 1 dòng Connection String duy nhất từ Neon (nếu có):
# DATABASE_URL=postgresql://neondb_owner:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ========================================================
# OPTION 2: PostgreSQL Local (Nếu tự chạy Postgres trên máy)
# ========================================================
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=nutrimate_db
