# NutriMate Server Environment Variables
PORT=3000
NODE_ENV=development

# PostgreSQL Connection Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=nutrimate_db

# Frontend (if needed)
VITE_API_BASE_URL=/api

# CN_25: server-only OpenAI-compatible Chat Completions provider
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
# Shared with the team's authentication module; HS256, at least 32 characters.
JWT_SECRET=
