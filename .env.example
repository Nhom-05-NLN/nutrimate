# NutriMate Server Environment Variables
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# ========================================================
# OPTION 1: PostgreSQL Cloud (Khuyên dùng cho nhóm - Neon.tech)
# ========================================================
PGHOST=ep-example-pooler.ap-southeast-1.aws.neon.tech
PGPORT=5432
PGUSER=neondb_owner
PGPASSWORD=your_neon_password
PGDATABASE=neondb
PGSSLMODE=require
PGCHANNELBINDING=require

# Hoặc dùng 1 dòng Connection String duy nhất từ Neon (nếu có):
# DATABASE_URL=postgresql://neondb_owner:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ========================================================
# OPTION 2: PostgreSQL Local (Nếu tự chạy Postgres trên máy)
# ========================================================
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=nutrimate_db

# Frontend (if needed)
VITE_API_BASE_URL=/api

# CN_25: server-only OpenAI-compatible Chat Completions provider
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# Nutrition image uploads are stored on this server's persistent disk.
NUTRITION_IMAGE_STORAGE_DIR=uploads/nutrition-images
