{
  "name": "nutrimate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:fe": "vite",
    "build:fe": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:ox": "oxlint --fix",
    "lint:ox:check": "oxlint",
    "verify": "bun run typecheck && bun run build",
    "verify:ci": "bun run typecheck && bun run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-vue-next": "^0.475.0",
    "pg": "^8.13.3",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@vitejs/plugin-vue": "^5.2.1",
    "esbuild": "^0.25.0",
    "oxlint": "^0.15.11",
    "tailwindcss": "^4.0.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.8"
  }
}
